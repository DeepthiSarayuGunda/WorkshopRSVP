@model List<WorkshopRSVP.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

<a href="/events/create" class="btn btn-success mb-3">Create New Event</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@ev.Location</td>
                <td>
                    <a href="/events/details/@ev.Id">Details</a> |
                    <a href="/events/edit/@ev.Id">Edit</a> |
                    <a href="/events/delete/@ev.Id">Delete</a> |
                    <a href="/events/@ev.Id/attendees">Attendees</a>
                </td>
            </tr>
        }
    </tbody>
</table>
