@model WorkshopRSVP.Models.Attendee

@{
    var ev = ViewBag.Event as WorkshopRSVP.Models.Event;
    ViewData["Title"] = "Delete Attendee";
}

<h1>Delete Attendee</h1>

<h3>Are you sure you want to remove this attendee from @ev?.Title?</h3>

<div class="mt-3" style="max-width: 500px;">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-controller="Attendees" asp-route-eventId="@ev?.Id" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="/events/@ev?.Id/attendees" class="ms-2">Back</a>
    </form>
</div>
