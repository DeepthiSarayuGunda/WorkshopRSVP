@model List<WorkshopRSVP.Models.Attendee>

@{
    var ev = ViewBag.Event as WorkshopRSVP.Models.Event;
    ViewData["Title"] = "Manage Attendees - " + ev?.Title;
}

<h1>Manage Attendees - @ev?.Title</h1>

<a href="/events/@ev?.Id/attendees/create" class="btn btn-success mb-3">Add Attendee</a>
<a href="/events/details/@ev?.Id" class="ms-2">Back to Event</a>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attendee in Model)
        {
            <tr>
                <td>@attendee.Name</td>
                <td>@attendee.Email</td>
                <td>
                    <a href="/events/@ev?.Id/attendees/edit/@attendee.Id">Edit</a> |
                    <a href="/events/@ev?.Id/attendees/delete/@attendee.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
