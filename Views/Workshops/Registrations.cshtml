@model List<WorkshopRSVP.Models.Rsvp>

@{
    ViewData["Title"] = "Registrations";
}

<h1>All Registrations</h1>

@if (Model.Count == 0)
{
    <p class="text-muted mt-3">No registrations yet.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>#</th>
                <th>Full Name</th>
                <th>Workshop</th>
                <th>Needs Accommodation</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model[i].FullName</td>
                    <td>@Model[i].WorkshopTitle</td>
                    <td>@(Model[i].NeedsAccommodation ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-controller="Workshops" asp-action="RsvpForm" class="btn btn-primary">Register for a Workshop</a>
</div>
