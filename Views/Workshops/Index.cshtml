@{
    ViewData["Title"] = "Workshops";
}

<h1>Workshop RSVP</h1>
<p>Welcome to the Workshop RSVP system. You can register for upcoming workshops and view all current registrations.</p>

<div class="mt-4">
    <a asp-controller="Workshops" asp-action="RsvpForm" class="btn btn-primary me-2">Register for a Workshop</a>
    <a asp-controller="Workshops" asp-action="Registrations" class="btn btn-secondary">View Registrations</a>
</div>
